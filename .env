# ===================================================
# LUXE APPAREL STORE - ENVIRONMENT CONFIGURATION
# ===================================================

# 💳 STRIPE PAYMENT GATEWAY CONFIGURATION
# Apni Stripe Public Key yahan paste karein (from dashboard.stripe.com/apikeys):
VITE_STRIPE_PUBLIC_KEY="pk_test_sample_your_stripe_key_here"

# 🗄️ MONGODB DATABASE CONFIGURATION
# Agar aap MongoDB Atlas use kar rahe hain to apna connection URI yahan dalein:
MONGODB_URI="mongodb+srv://admin:password@cluster0.mongodb.net/luxe_store?retryWrites=true&w=majority"
PORT=5000

# 🌐 STORE FRONTEND URL
VITE_STORE_URL="http://localhost:5173"
